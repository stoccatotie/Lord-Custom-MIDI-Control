<Window x:Class="MidiControl.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Guitar Pro MIDI Control"
        Width="1200"
        Height="800"
        MinWidth="1000"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        Background="#10131A"
        Foreground="#EEF2F7"
        FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#191E28" />
        <SolidColorBrush x:Key="ControlBrush" Color="#232A36" />
        <SolidColorBrush x:Key="BorderBrush" Color="#343D4D" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#9CA8B8" />
        <SolidColorBrush x:Key="AccentBrush" Color="#6C8CFF" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#EEF2F7" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#EEF2F7" />
            <Setter Property="Background" Value="#2A3240" />
            <Setter Property="BorderBrush" Value="#3A4558" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="18,8" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#354052" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#52617A" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#202733" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="#829DFF" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#EEF2F7" />
            <Setter Property="Background" Value="{StaticResource ControlBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#EEF2F7" />
            <Setter Property="Background" Value="{StaticResource ControlBrush}" />
            <Setter Property="Padding" Value="10,7" />
        </Style>

        <Style TargetType="ListView">
            <Setter Property="Background" Value="#151A22" />
            <Setter Property="Foreground" Value="#DCE3EC" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style TargetType="ListViewItem">
            <Setter Property="Foreground" Value="#DCE3EC" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="4,9" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#202734" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#293653" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="Background" Value="#1D232E" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#151A22" />
            <Setter Property="Foreground" Value="#DCE3EC" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="RowBackground" Value="#151A22" />
            <Setter Property="AlternatingRowBackground" Value="#181E27" />
            <Setter Property="HorizontalGridLinesBrush" Value="#2A3240" />
            <Setter Property="VerticalGridLinesBrush" Value="#2A3240" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="Background" Value="#1D232E" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="10,9" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="#DCE3EC" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,5" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#293653" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="#EEF2F7" />
            <Setter Property="Background" Value="#232A36" />
            <Setter Property="BorderBrush" Value="#52617A" />
            <Setter Property="CaretBrush" Value="#EEF2F7" />
            <Setter Property="Padding" Value="5,3" />
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Margin="0,0,10,0" Text="Input Device:" />
                <ComboBox x:Name="InputDeviceComboBox" Grid.Column="1" />

                <TextBlock Grid.Column="3" Margin="0,0,10,0" Text="Output Device:" />
                <ComboBox x:Name="OutputDeviceComboBox" Grid.Column="4" />

                <Button x:Name="RefreshButton"
                        Grid.Column="6"
                        Content="Refresh"
                        Click="RefreshButton_Click" />
                <Button x:Name="StartButton"
                        Grid.Column="8"
                        Content="Start"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="StartButton_Click" />
                <Button x:Name="StopButton"
                        Grid.Column="10"
                        Content="Stop"
                        IsEnabled="False"
                        Click="StopButton_Click" />

                <CheckBox x:Name="AutoConnectCheckBox"
                          Grid.Column="12"
                          VerticalAlignment="Center"
                          Foreground="#DCE3EC"
                          Content="Auto-connect on startup" />

                <StackPanel Grid.Column="14" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusIndicator"
                             Width="11"
                             Height="11"
                             Margin="0,0,9,0"
                             Fill="#687384" />
                    <TextBlock x:Name="StatusText"
                               FontWeight="SemiBold"
                               Text="Stopped" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,18,0,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="52*" />
                <RowDefinition Height="16" />
                <RowDefinition Height="48*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Margin="0,0,0,12"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Text="Conversion Rules" />

                    <DataGrid x:Name="MappingsDataGrid"
                              Grid.Row="1"
                              AlternationCount="2"
                              Margin="0,0,0,12">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Width="75" Header="Enabled" Binding="{Binding IsEnabled}" />
                            <DataGridTextColumn Width="*" MinWidth="170" Header="Name" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTextColumn Width="80" Header="Input Ch" Binding="{Binding InputChannel, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTextColumn Width="90" Header="Input Note" Binding="{Binding InputNote, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTextColumn Width="85" Header="Note Name" IsReadOnly="True" Binding="{Binding InputNoteName}" />
                            <DataGridTextColumn Width="75" Header="Min Vel" Binding="{Binding MinimumVelocity, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTextColumn Width="90" Header="Output Ch" Binding="{Binding OutputChannel, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTextColumn Width="65" Header="CC" Binding="{Binding OutputController, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTextColumn Width="70" Header="Value" Binding="{Binding OutputValue, UpdateSourceTrigger=PropertyChanged}" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                        <Button Margin="0,0,10,0" Content="Add Rule" Click="AddRuleButton_Click" />
                        <Button Margin="0,0,10,0" Content="Delete Rule" Click="DeleteRuleButton_Click" />
                        <Button Margin="0,0,10,0" Content="Duplicate Rule" Click="DuplicateRuleButton_Click" />
                        <Button x:Name="MidiLearnButton"
                                Margin="0,0,10,0"
                                Content="MIDI Learn"
                                Click="MidiLearnButton_Click" />
                        <Button x:Name="CancelLearnButton"
                                Margin="0,0,10,0"
                                Content="Cancel Learn"
                                IsEnabled="False"
                                Visibility="Collapsed"
                                Click="CancelLearnButton_Click" />
                        <Button Content="Apply Changes"
                                Margin="0,0,10,0"
                                Style="{StaticResource AccentButtonStyle}"
                                Click="ApplyChangesButton_Click" />
                        <Button Content="Save Settings"
                                Click="SaveSettingsButton_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="2"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Margin="0,0,0,12"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Text="MIDI Monitor" />

                    <Border Grid.Row="1"
                            Background="#151A22"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="7">
                        <ListView x:Name="MidiMonitorListView">
                            <ListView.View>
                                <GridView AllowsColumnReorder="False">
                                    <GridViewColumn Width="110" Header="Time" DisplayMemberBinding="{Binding Time}" />
                                    <GridViewColumn Width="90" Header="Direction" DisplayMemberBinding="{Binding Direction}" />
                                    <GridViewColumn Width="170" Header="Message" DisplayMemberBinding="{Binding Message}" />
                                    <GridViewColumn Width="80" Header="Channel" DisplayMemberBinding="{Binding Channel}" />
                                    <GridViewColumn Width="235" Header="Data" DisplayMemberBinding="{Binding Data}" />
                                    <GridViewColumn Width="165" Header="Mapping" DisplayMemberBinding="{Binding Mapping}" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <TextBlock HorizontalAlignment="Left"
                       Foreground="{StaticResource MutedTextBrush}"
                       Text="Version 0.1.0" />
            <Button HorizontalAlignment="Right"
                    Content="Clear Log"
                    Click="ClearLogButton_Click" />
        </Grid>
    </Grid>
</Window>
