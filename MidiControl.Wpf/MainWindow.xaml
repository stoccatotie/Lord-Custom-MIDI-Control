<Window x:Class="MidiControl.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Guitar Pro MIDI Control"
        Width="1000"
        Height="650"
        MinWidth="860"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="#10131A"
        Foreground="#EEF2F7"
        FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#191E28" />
        <SolidColorBrush x:Key="ControlBrush" Color="#232A36" />
        <SolidColorBrush x:Key="BorderBrush" Color="#343D4D" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#9CA8B8" />
        <SolidColorBrush x:Key="AccentBrush" Color="#6C8CFF" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#EEF2F7" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#EEF2F7" />
            <Setter Property="Background" Value="#2A3240" />
            <Setter Property="BorderBrush" Value="#3A4558" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="18,8" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#354052" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#52617A" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#202733" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="#829DFF" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#EEF2F7" />
            <Setter Property="Background" Value="{StaticResource ControlBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#EEF2F7" />
            <Setter Property="Background" Value="{StaticResource ControlBrush}" />
            <Setter Property="Padding" Value="10,7" />
        </Style>

        <Style TargetType="ListView">
            <Setter Property="Background" Value="#151A22" />
            <Setter Property="Foreground" Value="#DCE3EC" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style TargetType="ListViewItem">
            <Setter Property="Foreground" Value="#DCE3EC" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="4,9" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#202734" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#293653" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="Background" Value="#1D232E" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Margin="0,0,10,0" Text="Input Device:" />
                <ComboBox x:Name="InputDeviceComboBox" Grid.Column="1" />

                <TextBlock Grid.Column="3" Margin="0,0,10,0" Text="Output Device:" />
                <ComboBox x:Name="OutputDeviceComboBox" Grid.Column="4" />

                <Button Grid.Column="6" Content="Refresh" Click="RefreshButton_Click" />
                <Button x:Name="StartButton"
                        Grid.Column="8"
                        Content="Start"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="StartButton_Click" />
                <Button x:Name="StopButton"
                        Grid.Column="10"
                        Content="Stop"
                        IsEnabled="False"
                        Click="StopButton_Click" />

                <StackPanel Grid.Column="12" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusIndicator"
                             Width="11"
                             Height="11"
                             Margin="0,0,9,0"
                             Fill="#687384" />
                    <TextBlock x:Name="StatusText"
                               FontWeight="SemiBold"
                               Text="Stopped" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Margin="0,18,0,14"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Margin="0,0,0,14"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Text="MIDI Monitor" />

                <Border Grid.Row="1"
                        Background="#151A22"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="7">
                    <ListView x:Name="MidiMonitorListView">
                        <ListView.View>
                            <GridView AllowsColumnReorder="False">
                                <GridViewColumn Width="120" Header="Time" DisplayMemberBinding="{Binding Time}" />
                                <GridViewColumn Width="110" Header="Direction" DisplayMemberBinding="{Binding Direction}" />
                                <GridViewColumn Width="270" Header="Message" DisplayMemberBinding="{Binding Message}" />
                                <GridViewColumn Width="100" Header="Channel" DisplayMemberBinding="{Binding Channel}" />
                                <GridViewColumn Width="190" Header="Data" DisplayMemberBinding="{Binding Data}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Border>
            </Grid>
        </Border>

        <Button Grid.Row="2"
                HorizontalAlignment="Right"
                Content="Clear Log"
                Click="ClearLogButton_Click" />
    </Grid>
</Window>
